{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHelf",
  "version": "0.2.0",
  "identifier": "fr.sshelf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSHelf",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SSHelf",
    "category": "DeveloperTool",
    "shortDescription": "Client SSH léger et moderne",
    "longDescription": "SSHelf mémorise vos connexions SSH, les ouvre en un clic et les garde en onglets dans une seule fenêtre.",
    "homepage": "https://github.com/tguillain/SSHelf",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
